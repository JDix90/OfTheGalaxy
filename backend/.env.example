# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=of_the_galaxy_dev
DB_USER=postgres
DB_PASSWORD=change_me

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_generate_a_random_secret
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# OpenAI API (for AI dialogue system) — leave blank to use template-only dialogue fallback
OPENAI_API_KEY=

# Logging
LOG_LEVEL=debug
